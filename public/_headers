# Everything under _nuxt carries a content hash in its name, so it can never
# go stale. This includes Vite-built stroke shards and flags.
/_nuxt/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

# The browser checks these stable PWA entry points for every release. Keeping
# their response URLs stable while forcing validation lets Cloudflare's ETag
# avoid a download when the bytes are unchanged without pinning an old worker.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

# Generated font CSS and binaries keep stable URLs so server and client builds
# cannot disagree about a Vite hash. Revalidate them across deployments.
/fonts/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, no-cache

# Notices and license texts deliberately keep stable URLs. They may change
# independently of the Vite asset graph, so every reuse must be revalidated.
/notices/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, no-cache

# Wrangler detects Markdown's media type but does not attach a charset. Without
# one, Chrome falls back to Windows-1252 instead of decoding these UTF-8 files.
/notices/*.md
  Content-Type: text/markdown; charset=utf-8

# External consumers need one stable character-data URL. Keep it fresh for an
# hour, then allow one day of non-blocking stale responses while revalidating.
/data/chars.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Search engines should revalidate the stable discovery files after a deploy.
/sitemap.xml
  Cache-Control: public, no-cache

/robots.txt
  Cache-Control: public, no-cache
