# Everything under _nuxt carries a content hash in its name, so it can never
# go stale. The fonts and the character table keep stable names across builds
# and are deliberately left on the default policy.
/_nuxt/*
  Cache-Control: public, max-age=31536000, immutable

/data/*.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=0, must-revalidate

# Stroke shards are public generated datasets, without a custom cache policy.
/strokes/*
  Access-Control-Allow-Origin: *
