{
  "name": "hanji",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "description": "把同一个汉字并排、叠印，照见中国大陆、香港、台湾、日本与韩国之间细微而真实的字形差异。",
  "author": "Kevin Deng <sxzz@sxzz.moe>",
  "license": "MIT",
  "imports": {
    "#shared/*": "./shared/*"
  },
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "dev:pwa": "NUXT_PWA_DEV=1 nuxt dev",
    "prebuild": "pnpm build:pwa-icons",
    "build": "nuxt build",
    "pregenerate": "pnpm build:pwa-icons",
    "generate": "nuxt generate",
    "postgenerate": "pnpm check:pwa",
    "preview": "nuxt preview",
    "preview:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "nuxt typecheck",
    "lint": "eslint --cache",
    "format": "prettier --write .",
    "test": "vitest run",
    "optimize:svg": "svgo --config svgo.config.mjs public/logo.svg public/logo-seal.svg public/favicon.svg",
    "build:pwa-icons": "node scripts/build-pwa-icons.ts",
    "check:pwa": "node scripts/check-pwa-output.ts",
    "build:dataset": "node scripts/build-data.ts",
    "build:fonts": "node scripts/build-fonts.ts",
    "build:data": "pnpm build:dataset && pnpm build:fonts",
    "build:og": "node scripts/build-og-images.ts",
    "update:sources": "node scripts/update-sources.ts",
    "postinstall": "nuxt prepare",
    "prepare": "husky"
  },
  "dependencies": {
    "@iconify-json/ooui": "catalog:",
    "@iconify-json/ri": "catalog:",
    "@iconify-json/simple-icons": "catalog:",
    "@nuxtjs/robots": "catalog:",
    "@nuxtjs/sitemap": "catalog:",
    "@unocss/nuxt": "catalog:",
    "@unocss/reset": "catalog:",
    "@vite-pwa/nuxt": "catalog:",
    "@vueuse/core": "catalog:",
    "@vueuse/nuxt": "catalog:",
    "@vueuse/router": "catalog:",
    "nuxt": "catalog:",
    "nuxt-site-config": "catalog:",
    "unocss": "catalog:",
    "vue": "catalog:",
    "workbox-window": "catalog:"
  },
  "devDependencies": {
    "@resvg/resvg-js": "catalog:",
    "@sxzz/eslint-config": "catalog:",
    "@sxzz/prettier-config": "catalog:",
    "@types/fontkit": "catalog:",
    "@types/node": "catalog:",
    "@types/subset-font": "catalog:",
    "@unocss/eslint-plugin": "catalog:",
    "eslint": "catalog:",
    "fflate": "catalog:",
    "fontkit": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "satori": "catalog:",
    "sharp": "catalog:",
    "subset-font": "catalog:",
    "svgo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:",
    "wrangler": "catalog:"
  },
  "lint-staged": {
    "*": [
      "prettier --ignore-unknown --write",
      "eslint --cache --fix"
    ]
  },
  "prettier": "@sxzz/prettier-config"
}
